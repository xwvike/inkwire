{
 "version": 1,
 "orientation": "landscape",
 "background": "white",
 "root": {
  "type": "row",
  "crossAlign": "stretch",
  "children": [
   {
    "basis": 16,
    "node": {
     "type": "stack",
     "children": [
      {"type": "rectangle", "fill": "black"},
      {
       "type": "transformed",
       "turns": 3,
       "child": {
        "type": "text",
        "align": "center",
        "verticalAlign": "middle",
        "runs": [{"text": "LAYOUT SHOWCASE", "font": "monaco", "size": 12, "ink": "white"}]
       }
      }
     ]
    }
   },
   {
    "grow": 1,
    "node": {
     "type": "column",
     "crossAlign": "stretch",
     "children": [
      {
       "basis": 18,
       "node": {
        "type": "stack",
        "children": [
         {"type": "rectangle", "fill": "black"},
         {
          "type": "padding",
          "insets": {"top": 0, "right": 5, "bottom": 0, "left": 5},
          "child": {
