            ]
           }
          }
         },
         {
          "right": 6, "bottom": 6, "width": 42, "height": 42, "layer": 1,
          "node": {
           "type": "clipShape",
           "shape": {"kind": "circle", "radius": "50%"},
           "child": {
            "type": "stack",
            "children": [
             {"type": "rectangle", "fill": "red"},
             {
              "type": "transformed",
              "scale": 2,
              "child": {
               "type": "text",
               "align": "center",
               "verticalAlign": "middle",
               "runs": [{"text": "7", "font": "monaco", "size": 12, "ink": "white"}]
              }
             }
            ]
           }
          }
         }
        ]
       }
      }
     ]
    }
   }
  ]
 }
}
