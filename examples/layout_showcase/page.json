           "child": {
            "type": "grid",
            "columns": ["auto", "1fr", "auto"],
            "rows": [14, 14, 14, "auto"],
            "columnGap": 5,
            "rowGap": 4,
            "children": [
             {"node": {"type": "text", "verticalAlign": "middle", "runs": [{"text": "CPU", "font": "monaco", "size": 12, "ink": "black"}]}},
