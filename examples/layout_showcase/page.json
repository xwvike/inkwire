               {"type": "padding", "insets": {"top": 2, "right": 2, "bottom": 2, "left": 2},
                "child": {"type": "row", "crossAlign": "stretch", "children": [
                 {"basis": "62%", "node": {"type": "rectangle", "fill": "black"}},
                 {"grow": 1, "node": {"type": "spacer"}}
                ]}}
              ]
             }},
             {"node": {"type": "text", "align": "end", "verticalAlign": "middle", "runs": [{"text": "62%", "font": "monaco", "size": 12, "ink": "black"}]}},

             {"node": {"type": "text", "verticalAlign": "middle", "runs": [{"text": "MEM", "font": "monaco", "size": 12, "ink": "black"}]}},
             {"node": {
              "type": "stack",
              "children": [
               {"type": "rectangle", "stroke": {"ink": "black", "width": 1}},
               {"type": "padding", "insets": {"top": 2, "right": 2, "bottom": 2, "left": 2},
                "child": {"type": "row", "crossAlign": "stretch", "children": [
                 {"basis": "88%", "node": {"type": "rectangle", "fill": "red"}},
                 {"grow": 1, "node": {"type": "spacer"}}
                ]}}
              ]
             }},
             {"node": {"type": "text", "align": "end", "verticalAlign": "middle", "runs": [{"text": "88%", "font": "monaco", "size": 12, "ink": "red"}]}},

             {"node": {"type": "text", "verticalAlign": "middle", "runs": [{"text": "DISK", "font": "monaco", "size": 12, "ink": "black"}]}},
             {"node": {
              "type": "stack",
              "children": [
               {"type": "rectangle", "stroke": {"ink": "black", "width": 1}},
               {"type": "padding", "insets": {"top": 2, "right": 2, "bottom": 2, "left": 2},
                "child": {"type": "row", "crossAlign": "stretch", "children": [
                 {"basis": "35%", "node": {"type": "rectangle", "fill": "black"}},
                 {"grow": 1, "node": {"type": "spacer"}}
                ]}}
              ]
             }},
             {"node": {"type": "text", "align": "end", "verticalAlign": "middle", "runs": [{"text": "35%", "font": "monaco", "size": 12, "ink": "black"}]}},

             {
              "column": 1, "columnSpan": 3,
              "node": {
